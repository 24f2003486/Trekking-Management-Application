# Trekking Management Application V2 - Environment Configuration Example
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
DATABASE_URL=sqlite:///instance/tma.db
ADMIN_INITIAL_PASSWORD=YourStrongInitialAdminPasswordHere!

# JWT Configuration
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
